# ===== Asas =====
PORT=3000
# URL awam app ini (perlu HTTPS untuk webhook & supaya IG/Threads/TikTok boleh ambil media)
PUBLIC_URL=https://contoh-domain-anda.com
# Kata laluan untuk masuk dashboard (username: admin)
ADMIN_PASSWORD=tukar-kata-laluan-ini

# ===== Claude AI (cipta kandungan & balasan) =====
ANTHROPIC_API_KEY=

# ===== Telegram (Bot API) — dapatkan token dari @BotFather =====
TELEGRAM_BOT_TOKEN=
# Channel untuk post, cth @namachannel atau -100xxxxxxxxxx (bot mesti admin channel)
TELEGRAM_CHANNEL_ID=

# ===== Meta (WhatsApp Cloud API + Instagram) =====
# Token rawak pilihan anda, masukkan sama di Meta App > Webhooks
META_VERIFY_TOKEN=tukar-token-ini
# App Secret dari Meta App (untuk sahkan tandatangan webhook)
META_APP_SECRET=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram API (Instagram Login) — akaun Business/Creator
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ===== Threads API =====
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ===== TikTok Content Posting API =====
TIKTOK_ACCESS_TOKEN=
# PUBLIC_TO_EVERYONE perlukan app yang telah diaudit TikTok; sebelum itu guna SELF_ONLY
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

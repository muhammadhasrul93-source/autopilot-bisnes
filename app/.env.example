# ===== Asas =====
PORT=3000
# URL awam app ini (HTTPS). Digunakan untuk URL redirect OAuth, webhook & media.
# Dengan Cloudflare Tunnel, cth: https://app.coachyoi.com  (lihat deploy/CLOUDFLARE.md)
PUBLIC_URL=https://app.contoh-domain.com

# Token Cloudflare Tunnel (hanya untuk deploy Docker di VPS — deploy/docker-compose.yml)
TUNNEL_TOKEN=
# Kata laluan dashboard (PILIHAN). Jika kosong, anda cipta kata laluan di halaman /login
# kali pertama menggunakan kod persediaan yang dipaparkan dalam log server.
ADMIN_PASSWORD=

# ===== Claude AI (cipta kandungan & balasan) =====
# Boleh juga diisi dalam wizard Persediaan (langkah 2) — tidak perlu di sini.
ANTHROPIC_API_KEY=

# =====================================================================
# Akaun media sosial disambung dari dashboard (tab "Akaun"):
#   - Instagram, Threads, TikTok : butang "Log masuk dengan ..." (OAuth)
#   - WhatsApp                   : imbas QR / kod pautan (Peranti dipautkan)
#   - Telegram                   : tampal token bot dari @BotFather
# Untuk butang OAuth berfungsi, anda perlu daftar app pembangun SEKALI
# dan isi App ID/Secret di bawah. Redirect URI untuk didaftarkan:
#   {PUBLIC_URL}/oauth/instagram/callback
#   {PUBLIC_URL}/oauth/threads/callback
#   {PUBLIC_URL}/oauth/tiktok/callback
# =====================================================================

# Instagram (Meta App > Instagram > API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads (Meta App > use case "Access the Threads API")
THREADS_APP_ID=
THREADS_APP_SECRET=

# TikTok (developers.tiktok.com > Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# PUBLIC_TO_EVERYONE perlukan app yang telah diaudit TikTok; sebelum itu guna SELF_ONLY
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Webhook Instagram (komen & DM masa nyata). Pilihan — tanpa ini komen disemak berkala.
META_VERIFY_TOKEN=tukar-token-ini

# TikTok balas komen (BETA) — app berasingan di business-api.tiktok.com dengan kebenaran
# "TikTok Accounts" (Business Comment). Redirect URI: {PUBLIC_URL}/oauth/tiktokBiz/callback
TIKTOK_BIZ_APP_ID=
TIKTOK_BIZ_APP_SECRET=

{
  "name": "autopilot-sosial",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard web untuk urus TikTok, Instagram, WhatsApp, Telegram & Threads: cipta kandungan AI, auto-post, auto-balas komen & DM",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "mcp": "node mcp.js",
    "pasang": "node kit/setup.mjs",
    "tunnel:cuba": "cloudflared tunnel --url http://localhost:3000"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "baileys": "^7.0.0-rc14",
    "express": "^5.1.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "bin": {
    "autopilot-sosial-mcp": "mcp.js"
  }
}
